<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <!-- Suppress verbose logging from matplotlib4j and Python execution -->
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{HH:mm:ss.SSS} [%thread] %-5level %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>

    <!-- Suppress matplotlib4j and related loggers -->
    <logger name="com.github.sh0nk" level="ERROR"/>
    <logger name="com.github.sh0nk.matplotlib4j" level="ERROR"/>

    <!-- Suppress other verbose loggers if present -->
    <logger name="org.python" level="WARN"/>
    <logger name="jython" level="WARN"/>

    <!-- Root logger configuration - set to INFO by default -->
    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
    </root>
</configuration>
